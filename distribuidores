<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Cotizador Distribuidores Neobind</title>

<style>
body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto;
  background: #f5f5f7;
  margin:0;
  color:#323232;
}

.container {
  max-width: 600px;
  margin: 40px auto;
  background: #fff;
  padding: 28px;
  border-radius: 20px;
  box-shadow: 0 20px 60px rgba(0,0,0,0.08);
}

.logo { text-align:center; margin-bottom:20px; }
.logo img { width:130px; }

h2 { text-align:center; font-size:22px; margin-bottom:5px; font-weight:600; }

.subtitle {
  text-align:center;
  color:#888;
  font-size:14px;
  margin-bottom:20px;
}

.section-title{
  font-size:15px;
  font-weight:700;
  color:#323232;
  margin:26px 0 12px;
  padding-left:10px;
  border-left:3px solid #3ebbce;
}

input, select, textarea {
  width:100%;
  padding:12px;
  border-radius:12px;
  border:1px solid #ddd;
  font-size:14.5px;
  margin-bottom:12px;
  font-family:inherit;
  box-sizing:border-box;
}

textarea{ min-height:70px; resize:vertical; line-height:1.4; }

.manual-fields{ display:none; }

/* fila costo: label izquierda, input angosto a la derecha */
.cost-row{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:12px;
}
.cost-row label{ font-size:14.5px; flex:1; }
.cost-row input{ width:130px; margin-bottom:0; text-align:right; }

/* colores */
.colors {
  display:grid;
  grid-template-columns: repeat(4, 1fr);
  gap:10px;
  margin-bottom:6px;
}
.color-card {
  position:relative;
  height:70px;
  border-radius:12px;
  overflow:hidden;
  cursor:pointer;
}
.color-card img { width:100%; height:100%; object-fit:cover; }
.color-card::after {
  content:"";
  position:absolute; inset:0;
  background:linear-gradient(to top, rgba(0,0,0,0.55), transparent 60%);
}
.color-card .color-name {
  position:absolute; bottom:5px; left:6px;
  color:#fff; font-weight:600; font-size:10.5px; z-index:2;
  text-shadow:0 1px 4px rgba(0,0,0,0.7);
}
.color-card.selected { outline:3px solid #3ebbce; }

button {
  width:100%;
  padding:16px;
  border:none;
  border-radius:12px;
  background:#111;
  color:white;
  font-size:16px;
  cursor:pointer;
  margin-top:10px;
}
#downloadPdf{ background:#3ebbce; }
#downloadPdf:disabled{ opacity:0.6; }

/* ============ DOCUMENTO / PDF ============ */
.documento, .documento *{
  box-sizing:border-box;
}
.documento{
  display:none;
  max-width:600px;
  margin:28px auto 0;
  background:#fff;
  padding:32px;
  border-radius:16px;
  border:1px solid #e6e6e7;
}

.doc-header{
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
  margin-bottom:14px;
  border-bottom:2px solid #3ebbce;
  padding-bottom:16px;
}
.doc-header img{ width:110px; }
.doc-title{ text-align:right; }
.doc-title h1{ margin:0; font-size:21px; color:#323232; }
.doc-title .doc-tagline{ font-size:11.5px; color:#22808c; margin-top:2px; }

.doc-meta{
  display:flex;
  justify-content:space-between;
  font-size:11.5px;
  color:#97979b;
  margin-bottom:20px;
  flex-wrap:wrap;
  gap:6px;
}

.doc-why{
  display:flex;
  flex-wrap:wrap;
  gap:6px;
  margin-bottom:22px;
}
.doc-why span{
  background:#f2fbfc;
  color:#22808c;
  font-size:11px;
  font-weight:600;
  padding:5px 10px;
  border-radius:20px;
}

.doc-cliente{
  display:grid;
  grid-template-columns: auto 1fr;
  gap:6px 14px;
  margin-bottom:20px;
  font-size:14px;
}
.doc-cliente .label{ color:#97979b; font-weight:600; }
.doc-cliente .valor{ color:#323232; font-weight:700; }

.doc-color{
  display:flex; align-items:center; gap:14px;
  margin-bottom:8px;
  background:#f2fbfc;
  border-radius:14px;
  padding:12px 14px;
}
.doc-color img{ width:64px; height:64px; border-radius:12px; object-fit:cover; }
.doc-color .color-info b{ display:block; font-size:14px; margin-bottom:2px; }
.doc-color .color-info span{ font-size:11px; color:#97979b; }
.doc-color-nota{ font-size:10.5px; color:#97979b; margin:6px 0 20px; }

.doc-section-label{
  font-size:12px;
  font-weight:700;
  text-transform:uppercase;
  letter-spacing:0.5px;
  color:#22808c;
  margin:18px 0 8px;
}

table.doc-table{
  width:100%;
  table-layout:fixed;
  border-collapse:collapse;
  margin-bottom:0;
  font-size:13px;
}
table.doc-table th:nth-child(1), table.doc-table td:nth-child(1){ width:42%; }
table.doc-table th:nth-child(2), table.doc-table td:nth-child(2){ width:16%; }
table.doc-table th:nth-child(3), table.doc-table td:nth-child(3){ width:20%; }
table.doc-table th:nth-child(4), table.doc-table td:nth-child(4){ width:22%; }
table.doc-table th{
  background:#3ebbce;
  color:#fff;
  text-align:left;
  padding:10px 12px;
  font-weight:600;
}
table.doc-table th:nth-child(2), table.doc-table th:nth-child(3), table.doc-table th:nth-child(4){ text-align:right; }
table.doc-table td{ padding:10px 12px; border-bottom:1px solid #eee; word-break:break-word; }
table.doc-table td:nth-child(2), table.doc-table td:nth-child(3), table.doc-table td:nth-child(4){ text-align:right; }
table.doc-table tr:nth-child(even) td{ background:#f2fbfc; }

.doc-subtotal{
  text-align:right;
  font-size:12.5px;
  color:#323232;
  font-weight:700;
  padding:8px 12px 18px;
}

.doc-total-bar{
  display:flex;
  justify-content:space-between;
  align-items:center;
  background:#323232;
  color:#fff;
  padding:14px 16px;
  border-radius:10px;
  margin-bottom:22px;
}
.doc-total-bar .lbl{ font-size:12.5px; opacity:0.8; }
.doc-total-bar .val{ font-size:21px; font-weight:800; }

.doc-terms{
  border:1px solid #e6e6e7;
  border-radius:12px;
  padding:14px;
  margin-bottom:18px;
}
.doc-terms .titulo{ font-size:12px; font-weight:700; color:#22808c; margin-bottom:6px; }
.doc-terms .texto{ font-size:13px; white-space:pre-line; line-height:1.4; }

.doc-incluye{
  display:grid;
  grid-template-columns: 1fr 1fr;
  gap:14px;
  margin-bottom:20px;
}
.doc-incluye-box{ font-size:12.5px; }
.doc-incluye-box .titulo{ font-size:12px; font-weight:700; margin-bottom:6px; }
.doc-incluye-box.si .titulo{ color:#22808c; }
.doc-incluye-box.no .titulo{ color:#97979b; }
.doc-incluye-box ul{ margin:0; padding-left:16px; line-height:1.5; }
.doc-incluye-box.no ul{ color:#97979b; }

.doc-disclaimer-strong{
  background:#f7f7f8;
  border:1px solid #eee;
  border-radius:12px;
  padding:12px 14px;
  font-size:11px;
  color:#6b6b6e;
  line-height:1.5;
  margin-bottom:20px;
}

.doc-footer{
  display:flex;
  justify-content:space-between;
  align-items:center;
  border-top:1px solid #eee;
  padding-top:16px;
  font-size:13px;
  flex-wrap:wrap;
  gap:12px;
}
.doc-badges{ display:flex; gap:8px; flex-wrap:wrap; }
.doc-badge{
  background:#f2fbfc;
  color:#22808c;
  border-radius:20px;
  padding:6px 12px;
  font-size:12px;
  font-weight:600;
}
.doc-contacto{ text-align:right; color:#97979b; font-size:12px; }
.doc-contacto b{ color:#323232; display:block; font-size:13.5px; }

.doc-cta{ text-align:center; margin-top:20px; }
.doc-cta-btn{
  display:inline-block;
  background:#25D366;
  color:#fff;
  text-decoration:none;
  font-weight:700;
  font-size:14px;
  padding:12px 26px;
  border-radius:30px;
}

.dist-fijo-confirm{
  font-size:13.5px;
  color:#22808c;
  background:#f2fbfc;
  border-radius:10px;
  padding:10px 14px;
  margin-bottom:14px;
}

.adicional-row{
  display:flex;
  align-items:center;
  gap:10px;
  margin-bottom:10px;
}
.adicional-row label{
  flex:1;
  display:flex;
  align-items:center;
  gap:8px;
  font-size:14px;
  cursor:pointer;
}
.adicional-row input[type="checkbox"]{ width:auto; margin:0; }
.adicional-row input[type="number"], .adicional-row input[type="text"]{
  width:110px;
  margin-bottom:0;
  text-align:right;
}

@media (max-width:480px){
  .doc-header{ flex-direction:column; gap:10px; }
  .doc-title{ text-align:left; }
  .doc-incluye{ grid-template-columns: 1fr; }
  .doc-footer{ flex-direction:column; align-items:flex-start; }
  .doc-contacto{ text-align:left; }
}

@media print{
  @page{ size:A4; margin:8mm; }
  html, body{
    background:#fff !important;
    -webkit-print-color-adjust:exact;
    print-color-adjust:exact;
    color-adjust:exact;
    margin:0;
  }
  .container{ display:none !important; }
  #preview{
    display:block !important;
    -webkit-print-color-adjust:exact;
    print-color-adjust:exact;
    color-adjust:exact;
    margin:0;
    padding:0;
    border:none;
    box-shadow:none;
    font-size:12.5px;
  }
  #preview *{
    -webkit-print-color-adjust:exact;
    print-color-adjust:exact;
    color-adjust:exact;
  }
  #preview .doc-header{ padding-bottom:8px; margin-bottom:8px; }
  #preview .doc-header img{ width:80px; }
  #preview .doc-title h1{ font-size:18px; }
  #preview .doc-meta{ margin-bottom:6px; font-size:10.5px; }
  #preview .doc-why{ margin-bottom:8px; gap:4px; }
  #preview .doc-why span{ padding:3px 8px; font-size:9.5px; }
  #preview .doc-cliente{ margin-bottom:6px; font-size:12px; gap:3px 14px; }
  #preview .doc-color-nota{ margin:2px 0 6px !important; font-size:9px; }
  #preview .doc-color{ padding:8px 10px; margin-bottom:0; }
  #preview .doc-color img{ width:44px; height:44px; }
  #preview .doc-section-label{ margin:8px 0 4px; font-size:10.5px; }
  #preview table.doc-table th, #preview table.doc-table td{ padding:5px 8px; font-size:11px; }
  #preview .doc-subtotal{ padding:4px 8px 8px; font-size:10.5px; }
  #preview .doc-total-bar{ padding:10px 14px; margin-bottom:10px; }
  #preview .doc-total-bar .val{ font-size:17px; }
  #preview .doc-terms{ padding:8px 10px; margin-bottom:8px; }
  #preview .doc-terms .texto{ font-size:11px; }
  #preview .doc-incluye{ margin-bottom:6px; gap:10px; }
  #preview .doc-incluye-box{ font-size:10.5px; }
  #preview .doc-disclaimer-strong{ padding:8px 10px; margin-bottom:8px; font-size:9px; }
  #preview .doc-footer{ padding-top:8px; font-size:10.5px; }
  #preview .doc-cta{ margin-top:10px; }
  #preview .doc-cta-btn{ padding:8px 18px; font-size:11px; }

  /* Ninguna de estas cajas se corta entre hojas: o entra completa, o pasa entera a la página siguiente */
  #preview .doc-header,
  #preview .doc-total-bar,
  #preview .doc-terms,
  #preview .doc-incluye,
  #preview .doc-disclaimer-strong,
  #preview .doc-footer,
  #preview table.doc-table,
  #preview table.doc-table tr{
    page-break-inside: avoid;
    break-inside: avoid;
  }
}
</style>
</head>

<body>

<div class="container">

<div class="logo">
<img src="https://raw.githubusercontent.com/Neobind737/Cotizador-Neobind/main/NEO%20MARCA.png">
</div>

<h2>Cotizador para distribuidores independientes</h2>
<div class="subtitle">Armá el presupuesto y descargalo en PDF para tu cliente</div>

<div class="section-title">Distribuidor independiente</div>
<div id="distribuidorFijo" class="dist-fijo-confirm" style="display:none;"></div>
<div id="distribuidorManual" class="manual-fields">
  <input id="distNombreManual" placeholder="Nombre y apellido">
  <input id="distZonaManual" placeholder="Zona / Ciudad">
  <input id="distTelefonoManual" placeholder="Tu WhatsApp de contacto (ej: 5493511234567)">
</div>

<div class="section-title">Datos del cliente</div>
<input id="clienteNombre" placeholder="Nombre del cliente">
<input id="clienteLocalidad" placeholder="Localidad">
<input id="m2Input" type="number" placeholder="m² de la pileta">

<div class="section-title">Color de venecita (opcional)</div>
<div class="colors">
  <div class="color-card" onclick="selColor(this,'Blanco Nácar','https://raw.githubusercontent.com/Neobind737/Cotizador-Neobind/main/img/blanco.jpg')">
    <img src="https://raw.githubusercontent.com/Neobind737/Cotizador-Neobind/main/img/blanco.jpg">
    <div class="color-name">Blanco Nácar</div>
  </div>
  <div class="color-card" onclick="selColor(this,'Agua Marina','https://raw.githubusercontent.com/Neobind737/Cotizador-Neobind/main/img/aguamarina.jpg')">
    <img src="https://raw.githubusercontent.com/Neobind737/Cotizador-Neobind/main/img/aguamarina.jpg">
    <div class="color-name">Agua Marina</div>
  </div>
  <div class="color-card" onclick="selColor(this,'Turquesa','https://raw.githubusercontent.com/Neobind737/Cotizador-Neobind/main/img/turquesa.jpg')">
    <img src="https://raw.githubusercontent.com/Neobind737/Cotizador-Neobind/main/img/turquesa.jpg">
    <div class="color-name">Turquesa</div>
  </div>
  <div class="color-card" onclick="selColor(this,'Azul','https://raw.githubusercontent.com/Neobind737/Cotizador-Neobind/main/img/azul.jpg')">
    <img src="https://raw.githubusercontent.com/Neobind737/Cotizador-Neobind/main/img/azul.jpg">
    <div class="color-name">Azul</div>
  </div>
  <div class="color-card" onclick="selColor(this,'Verde Esmeralda','https://raw.githubusercontent.com/Neobind737/Cotizador-Neobind/main/img/verde.jpg')">
    <img src="https://raw.githubusercontent.com/Neobind737/Cotizador-Neobind/main/img/verde.jpg">
    <div class="color-name">Verde Esmeralda</div>
  </div>
  <div class="color-card" onclick="selColor(this,'Negro','https://raw.githubusercontent.com/Neobind737/Cotizador-Neobind/main/img/negro.jpg')">
    <img src="https://raw.githubusercontent.com/Neobind737/Cotizador-Neobind/main/img/negro.jpg">
    <div class="color-name">Negro</div>
  </div>
  <div class="color-card" onclick="selColor(this,'Gris','https://raw.githubusercontent.com/Neobind737/Cotizador-Neobind/main/img/gris.jpg')">
    <img src="https://raw.githubusercontent.com/Neobind737/Cotizador-Neobind/main/img/gris.jpg">
    <div class="color-name">Gris</div>
  </div>
  <div class="color-card" onclick="selColor(this,'','')">
    <img src="https://raw.githubusercontent.com/Neobind737/Cotizador-Neobind/main/img/catalogo.jpg">
    <div class="color-name">Sin definir</div>
  </div>
</div>

<div class="section-title">Precio de venta por m²</div>
<div class="cost-row">
  <label>Venecitas</label>
  <input id="costoVenecita" type="number" value="19980">
</div>
<div class="cost-row">
  <label>Materiales (adhesivo + pastina)</label>
  <input id="costoMateriales" type="number" value="8400">
</div>
<div class="cost-row">
  <label>Mano de obra / colocación</label>
  <input id="costoColocacion" type="number" value="31000">
</div>

<div class="section-title">Adicionales (opcional)</div>
<div class="adicional-row">
  <label><input type="checkbox" id="addRetiro"> Retiro de revestimiento existente</label>
  <input type="number" id="addRetiroMonto" placeholder="$">
</div>
<div class="adicional-row">
  <label><input type="checkbox" id="addTraslado"> Traslado / flete</label>
  <input type="number" id="addTrasladoMonto" placeholder="$">
</div>
<div class="adicional-row">
  <label><input type="checkbox" id="addViaticos"> Viáticos</label>
  <input type="number" id="addViaticosMonto" placeholder="$">
</div>
<div class="adicional-row">
  <input type="text" id="addOtroLabel" placeholder="Otro adicional (descripción)" style="flex:1; margin-bottom:0;">
  <input type="number" id="addOtroMonto" placeholder="$">
</div>

<div class="section-title">Condiciones de pago</div>
<textarea id="condicionPago">20% al momento de confirmar la cotización, 50% al momento de la descarga de materiales, 30% al finalizar la obra.</textarea>

<div class="cost-row">
  <label>Duración estimada del trabajo</label>
  <input id="duracion" value="5 días aprox" style="width:150px;">
</div>
<div class="cost-row">
  <label>Fecha de disponibilidad de comienzo aprox.</label>
  <input id="disponibilidad" value="(completar con fecha)" style="width:150px;">
</div>
<div class="cost-row">
  <label>Presupuesto válido por</label>
  <input id="validez" value="5 días" style="width:150px;">
</div>

<button onclick="generar()">Generar presupuesto</button>

</div>

<div id="preview" class="documento"></div>

<div class="container" style="margin-top:16px;">
  <button id="printBtn" onclick="window.print()" style="display:none;">📄 Descargar presupuesto (PDF)</button>
</div>

<script>
// 👇 Para sumar un distribuidor nuevo, agregá una línea acá.
// "precios" es OPCIONAL: si no lo ponés, ese distribuidor usa los valores
// por defecto del formulario. Si lo agregás, pisa solo los que definas.
const DISTRIBUIDORES = {
  cordoba: {
    nombre:"Rodrigo Negrete",
    zona:"Córdoba",
    telefono:"+54 9 3548 50-0669"
    // precios: { venecita: 19980, materiales: 8400, colocacion: 31000 }
  },
  rosario: {
    nombre:"Ignacio Anunciatta",
    zona:"Rosario",
    telefono:"" // TODO: completar WhatsApp de Ignacio
  }
};

let color = "";
let colorImgUrl = "";

function selColor(el, nombre, imgUrl){
  color = nombre;
  colorImgUrl = imgUrl;
  document.querySelectorAll('.color-card').forEach(e=>e.classList.remove('selected'));
  el.classList.add('selected');
}

let distribuidorActivo = null; // se completa si el link trae ?d=codigo válido

function onDistribuidorChange(){
  const fijo = document.getElementById("distribuidorFijo");
  if(distribuidorActivo){
    fijo.textContent = `Vas a generar este presupuesto como ${distribuidorActivo.nombre} — ${distribuidorActivo.zona}`;
    fijo.style.display = "block";
    document.getElementById("distribuidorManual").style.display = "none";

    // Si este distribuidor tiene precios propios definidos, los precargamos
    if(distribuidorActivo.precios){
      if(distribuidorActivo.precios.venecita != null) document.getElementById("costoVenecita").value = distribuidorActivo.precios.venecita;
      if(distribuidorActivo.precios.materiales != null) document.getElementById("costoMateriales").value = distribuidorActivo.precios.materiales;
      if(distribuidorActivo.precios.colocacion != null) document.getElementById("costoColocacion").value = distribuidorActivo.precios.colocacion;
    }
  } else {
    fijo.style.display = "none";
    document.getElementById("distribuidorManual").style.display = "block";
  }
}

window.addEventListener("DOMContentLoaded", () => {
  const params = new URLSearchParams(window.location.search);
  const d = params.get("d");
  if(d && DISTRIBUIDORES[d]){
    distribuidorActivo = DISTRIBUIDORES[d];
  }
  onDistribuidorChange();
});

function generar(){
  const m2 = parseFloat(document.getElementById("m2Input").value);
  if(!m2 || m2<=0) return alert("Ingresá los m² de la pileta");

  const cliente = document.getElementById("clienteNombre").value || "Cliente";
  const localidad = document.getElementById("clienteLocalidad").value || "-";

  const costoVen = parseFloat(document.getElementById("costoVenecita").value) || 0;
  const costoMat = parseFloat(document.getElementById("costoMateriales").value) || 0;
  const costoMO  = parseFloat(document.getElementById("costoColocacion").value) || 0;

  const f = n => Math.round(n).toString().replace(/\B(?=(\d{3})+(?!\d))/g,".");

  // Adicionales del checklist: solo entran si están tildados y tienen monto
  const adicionales = [];
  const chkRetiro = document.getElementById("addRetiro").checked;
  const montoRetiro = parseFloat(document.getElementById("addRetiroMonto").value) || 0;
  if(chkRetiro && montoRetiro>0) adicionales.push({label:"Retiro de revestimiento existente", monto:montoRetiro});

  const chkTraslado = document.getElementById("addTraslado").checked;
  const montoTraslado = parseFloat(document.getElementById("addTrasladoMonto").value) || 0;
  if(chkTraslado && montoTraslado>0) adicionales.push({label:"Traslado / flete", monto:montoTraslado});

  const chkViaticos = document.getElementById("addViaticos").checked;
  const montoViaticos = parseFloat(document.getElementById("addViaticosMonto").value) || 0;
  if(chkViaticos && montoViaticos>0) adicionales.push({label:"Viáticos", monto:montoViaticos});

  const otroLabel = document.getElementById("addOtroLabel").value;
  const otroMonto = parseFloat(document.getElementById("addOtroMonto").value) || 0;
  if(otroLabel && otroMonto>0) adicionales.push({label:otroLabel, monto:otroMonto});

  const venTotal = m2*costoVen;
  const matTotal = m2*costoMat;
  const moTotal  = m2*costoMO;
  const adicionalesTotal = adicionales.reduce((s,a)=>s+a.monto, 0);

  const subtotalProductos = venTotal + matTotal;
  const subtotalColocacion = moTotal + adicionalesTotal;
  const total = subtotalProductos + subtotalColocacion;

  let distNombre, distZona, distTelefono;
  if(distribuidorActivo){
    distNombre = distribuidorActivo.nombre;
    distZona = distribuidorActivo.zona;
    distTelefono = distribuidorActivo.telefono || "";
  } else {
    distNombre = document.getElementById("distNombreManual").value || "Distribuidor independiente";
    distZona = document.getElementById("distZonaManual").value || "";
    distTelefono = document.getElementById("distTelefonoManual").value.trim();
  }
  const validez = document.getElementById("validez").value;

  const ahora = new Date();
  const fecha = ahora.toLocaleDateString("es-AR",{day:"2-digit",month:"2-digit",year:"numeric"});
  // Código de referencia único (fecha + random). No es un correlativo real: eso requiere un registro centralizado.
  const codigoRandom = Math.random().toString(36).substring(2,6).toUpperCase();
  const numeroPresupuesto = `NB-${ahora.getFullYear()}${String(ahora.getMonth()+1).padStart(2,"0")}${String(ahora.getDate()).padStart(2,"0")}-${codigoRandom}`;

  // Botón de WhatsApp: solo aparece si hay un teléfono cargado
  let ctaWhatsapp = "";
  const telefonoLimpio = (distTelefono || "").replace(/\D/g, "");
  if(telefonoLimpio){
    const msjWa = encodeURIComponent(`Hola ${distNombre}! Quiero consultar sobre la propuesta N.º ${numeroPresupuesto}`);
    ctaWhatsapp = `
    <div class="doc-cta">
      <a href="https://wa.me/${telefonoLimpio}?text=${msjWa}" target="_blank" class="doc-cta-btn">📲 Consultar por WhatsApp</a>
    </div>`;
  }

  let filasAdicionales = adicionales.map(a =>
    `<tr><td>${a.label}</td><td>—</td><td>—</td><td>$${f(a.monto)}</td></tr>`
  ).join("");

  let colorBlock = "";
  let colorNota = "";
  if(color){
    colorBlock = `
    <div class="doc-color">
      <img src="${colorImgUrl}" crossorigin="anonymous">
      <div class="color-info"><b>${color}</b><span>Color primario</span></div>
    </div>`;
    colorNota = `<div class="doc-color-nota">Si el proyecto incluye guarda u otro color secundario, también queda contemplado dentro de la superficie total presupuestada.</div>`;
  }

  // Incluye: base fija + lo que se haya tildado como adicional
  const incluyeItems = [
    "Venecitas Neobind según m² presupuestados",
    "Materiales de colocación especificados",
    "Servicio de colocación"
  ].concat(adicionales.map(a => a.label));

  const noIncluyeItems = [
    "Reparaciones o preparación extraordinaria de la superficie",
    "Reparaciones estructurales",
    "Tratamientos especiales de la superficie",
    "Trabajos adicionales no contemplados en este presupuesto"
  ];

  const html = `
    <div class="doc-header">
      <img src="https://raw.githubusercontent.com/Neobind737/Cotizador-Neobind/main/NEO%20MARCA.png" crossorigin="anonymous">
      <div class="doc-title">
        <h1>Propuesta Comercial</h1>
        <div class="doc-tagline">Presupuesto N.º ${numeroPresupuesto}</div>
      </div>
    </div>

    <div class="doc-meta">
      <span>Fecha: ${fecha}</span>
      <span>Válido por ${validez}</span>
    </div>

    <div class="doc-why">
      <span>Liviano</span><span>Flexible</span><span>Antideslizante</span>
      <span>Atérmico</span><span>Fácil colocación</span><span>100% reciclable</span>
    </div>

    <div class="doc-cliente">
      <div class="label">Cliente</div><div class="valor">${cliente}</div>
      <div class="label">Localidad</div><div class="valor">${localidad}</div>
      <div class="label">Superficie estimada a revestir</div><div class="valor">${m2} m²</div>
    </div>
    <div class="doc-color-nota" style="margin-top:-14px;">La superficie indicada es estimativa y deberá ser verificada antes de iniciar los trabajos.</div>

    ${colorBlock}
    ${colorNota}

    <div class="doc-section-label">Productos Neobind</div>
    <table class="doc-table">
      <thead><tr><th>Concepto</th><th>m²</th><th>$/m²</th><th>Total</th></tr></thead>
      <tbody>
        <tr><td>Venecitas Neobind</td><td>${m2}</td><td>$${f(costoVen)}</td><td>$${f(venTotal)}</td></tr>
        <tr><td>Materiales de colocación</td><td>${m2}</td><td>$${f(costoMat)}</td><td>$${f(matTotal)}</td></tr>
      </tbody>
    </table>
    <div class="doc-subtotal">Subtotal materiales: $${f(subtotalProductos)}</div>

    <div class="doc-section-label">Servicio de colocación</div>
    <table class="doc-table">
      <thead><tr><th>Concepto</th><th>m²</th><th>$/m²</th><th>Total</th></tr></thead>
      <tbody>
        <tr><td>Colocación</td><td>${m2}</td><td>$${f(costoMO)}</td><td>$${f(moTotal)}</td></tr>
        ${filasAdicionales}
      </tbody>
    </table>
    <div class="doc-subtotal">Subtotal colocación: $${f(subtotalColocacion)}</div>

    <div class="doc-total-bar">
      <span class="lbl">Total del proyecto</span>
      <span class="val">$${f(total)}</span>
    </div>

    <div class="doc-terms">
      <div class="titulo">Condiciones de pago</div>
      <div class="texto">${document.getElementById("condicionPago").value}</div>
    </div>

    <div class="doc-incluye">
      <div class="doc-incluye-box si">
        <div class="titulo">Incluye</div>
        <ul>${incluyeItems.map(i=>`<li>${i}</li>`).join("")}</ul>
      </div>
      <div class="doc-incluye-box no">
        <div class="titulo">No incluye</div>
        <ul>${noIncluyeItems.map(i=>`<li>${i}</li>`).join("")}</ul>
      </div>
    </div>
    <div class="doc-color-nota" style="margin-top:-14px;">Cualquier trabajo, material o servicio que no se encuentre expresamente detallado en este presupuesto se considera no incluido.</div>

    <div class="doc-disclaimer-strong">
      La provisión de venecitas y materiales corresponde a Neobind y/o al distribuidor, según la modalidad comercial acordada. El servicio de colocación constituye un servicio independiente, contratado directamente con el distribuidor identificado en este presupuesto. Neobind no interviene en la contratación, ejecución, dirección, supervisión ni pago de dichos trabajos, ni asume responsabilidad por los mismos.
    </div>

    <div class="doc-footer">
      <div class="doc-badges">
        <span class="doc-badge">Duración: ${document.getElementById("duracion").value}</span>
        <span class="doc-badge">Disponibilidad: ${document.getElementById("disponibilidad").value}</span>
      </div>
      <div class="doc-contacto">
        <b>${distNombre}</b>
        Distribuidor Independiente Neobind<br>
        ${distZona}${distTelefono ? "<br>WhatsApp: "+distTelefono : ""}
      </div>
    </div>
    ${ctaWhatsapp}
  `;

  const prev = document.getElementById("preview");
  prev.innerHTML = html;
  prev.style.display = "block";
  prev.scrollIntoView({behavior:"smooth", block:"start"});

  document.getElementById("printBtn").style.display = "block";
}
</script>

</body>
</html>
